# ---------------------------------------------------------------------------
# AutoKaggle working tree
#
# 原则：仓库只放源码 / 配置 / 文档 / 小体积报告。
# 权重、数据集、训练产物、本地环境一律不进仓库。
# ---------------------------------------------------------------------------

# ---------- Python / OS ----------
.venv/
.venv-win/
__pycache__/
*.pyc
.DS_Store

# ---------- local tooling / editor state ----------
.vscode/
_tmp/
.workbuddy/

# ---------- 实验输出 / 运行日志：根目录下统一收进 logs/ ----------
# 原先散落在一级目录的 *-out/ 与 .klogs/ 已归入此处；logs/ 整体不进仓库。
/logs/

# ---------- credentials ----------
kaggle.json
access_token
.env

# ---------- 大型资产：只匹配仓库根目录下的同名目录 ----------
# kaggle/ 只挡数据集快照（21G）；kernels/ 是源码，进版本控制
/kaggle/dataset/
/models/
/runs/
/data/
/third_party/
/submissions/
/_verify_scratch/

# ---------- 根目录临时产物（脚本可再生）----------
/_synth.npz
/_synth_train.csv
/calib_full.json
/calib_lmsys.json
/ntl-final-out/

# ---------- name-that-llm：只收源码与实验日志，构件不进仓库 ----------
solutions/name-that-llm/data/
solutions/name-that-llm/extra/
solutions/name-that-llm/*.npz
solutions/name-that-llm/*.npy
solutions/name-that-llm/*.jsonl
# 内核运行日志（kernels_output 下载，体积大且可重新拉取）
*-out/

# 从 Kaggle 数据集抽出来的小样本元数据 / 权重（体积大或第三方许可，仅本地校验用）
solutions/name-that-llm/ts_meta/
solutions/name-that-llm/prv_meta/

# ---------- 第三方参考代码（他人公开内核导出，含未声明许可，不作为本项目源码分发）----------
/ref/

# ---------- 样例竞赛输入数据（Kaggle 原始 csv，不是本项目产出）----------
multi_agents/competition/bank_churn/
multi_agents/competition/classification_with_an_academic_success_dataset/
multi_agents/competition/ghouls_goblins_and_ghosts_boo/
multi_agents/competition/house_prices/
multi_agents/competition/obesity_risks/
multi_agents/competition/plate_defect/
multi_agents/competition/spaceship_titanic/
multi_agents/competition/titanic/

# ---------- Competition data is CC BY-NC 4.0 and must NOT be redistributed ----------
multi_agents/competition/nfl_big_data_bowl_2027/data/
solutions/nfl_big_data_bowl_2027/data/

# ---------- generated artefacts (regenerable by the pipeline) ----------
solutions/nfl_big_data_bowl_2027/artifacts/
solutions/nfl_big_data_bowl_2027/cache/
multi_agents/experiments_history/
multi_agents/example_results/
multi_agents/competition/*/*.log
validation/runs/
validation/data/
validation/logs/
solutions/*/train/runs/
solutions/*/train/_smoke/
solutions/*/artifacts/_work/fixtures/

# ---------- 归档包：默认不要，但保留 gemma 的提交物 ----------
*.zip
!solutions/gemma_4_developer_agent/artifacts/*.zip
!solutions/gemma_4_developer_agent/artifacts/submissions/*/*.zip

# ---------- 日志 ----------
*.log
